{
  "name": "react-keybound",
  "version": "0.1.0",
  "description": "Compile-time keyboard interactions for React. Inline mnemonics, shortcuts, scopes and hints.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Eggwite",
    "email": "contact@eggwite.moe",
    "url": "https://github.com/Eggwite"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eggwite/keybound.git",
    "directory": "packages/react-keybound"
  },
  "homepage": "https://keybound.eggwite.moe",
  "bugs": {
    "url": "https://github.com/Eggwite/keybound/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./babel": {
      "types": "./dist/babel.d.ts",
      "import": "./dist/babel.js",
      "default": "./dist/babel.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "import": "./dist/compiler.js",
      "default": "./dist/compiler.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "default": "./dist/next.js"
    },
    "./loader": "./dist/loader.cjs",
    "./jsx": {
      "types": "./dist/jsx.d.ts"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js",
      "default": "./dist/adapters.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@babel/core": "^7.28.0"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "react",
    "mnemonic",
    "hotkey",
    "keyboard",
    "accessibility",
    "nextjs",
    "vite",
    "shadcn",
    "babel-plugin"
  ]
}
